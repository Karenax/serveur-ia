 _JSON_FENCE = re.compile(r"```[ \t]*(?:json)?[ \t]*\r?\n\s*", re.I)
 
 
+def _boolean_only_schema(schema: dict) -> bool:
+    """A boolean (possibly nullable), never a union that also accepts strings."""
+    kind = schema.get("type")
+    if kind == "boolean":
+        return True
+    if isinstance(kind, list):
+        return "boolean" in kind and all(t in ("boolean", "null") for t in kind)
+    variants = schema.get("anyOf") or schema.get("oneOf")
+    if isinstance(variants, list) and variants and all(isinstance(s, dict) for s in variants):
+        return any(_boolean_only_schema(s) for s in variants) and all(
+            _boolean_only_schema(s) or s.get("type") == "null" for s in variants)
+    return False
+
+
+def _normalize_tool_value(value, schema: dict):
+    """Repair only literal true/false strings where the declared type is boolean.
+
+    Qwen sometimes emits Python's True/False in XML, or quotes those literals in
+    JSON. Do not infer booleans from numbers, yes/no, arbitrary text or untyped
+    fields; string-valued tool arguments must remain byte-for-byte intact.
+    """
+    if not isinstance(schema, dict):
+        return value
+    if isinstance(value, str) and _boolean_only_schema(schema):
+        literal = value.strip().lower()
+        if literal in ("true", "false"):
+            return literal == "true"
+    if isinstance(value, dict):
+        props = schema.get("properties") or {}
+        if isinstance(props, dict):
+            return {k: _normalize_tool_value(v, props.get(k) or {}) for k, v in value.items()}
+    if isinstance(value, list) and isinstance(schema.get("items"), dict):
+        return [_normalize_tool_value(v, schema["items"]) for v in value]
+    return value
+
