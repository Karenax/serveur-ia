{
  "manifest_version": 2,
  "name": "Infomaniak Auto Local — indépendant",
  "version": "0.2.0",
  "description": "Enregistre localement l’original EML des messages ouverts dans Infomaniak Mail.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fred-mail-auto-local@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["none"]}
    },
    "gecko_android": {"strict_min_version": "142.0"}
  },
  "permissions": ["storage", "downloads", "https://mail.infomaniak.com/*"],
  "background": {"scripts": ["core.js", "background.js"], "persistent": true},
  "browser_action": {"default_title": "Infomaniak Auto Local — actif"},
  "content_scripts": [{"matches": ["https://mail.infomaniak.com/*"], "all_frames": true, "run_at": "document_start", "js": ["core.js", "content.js"]}]
}
